# Binary build outputs (go build -o)
/jailor
/jailord
/probe
/dbgtest
*.test
*.out
*.prof
coverage.*
*.exe

# Machine-specific prepared rootfs (host binaries & glibc; regenerable with scripts/build-rootfs.sh)
/rootfs/

# Local runtime state written by jailor/jailord (default state root is per-user, outside the repo; these guard against overriding --ledger into the checkout)
/.jailor/
/ledger/
/store/
/networks/
/containers/
*.sock

# Registry credentials — never commit these (default location is ~/.config/jailor/auth.json)
auth.json
*jailor-auth*
*.pem
*.key

# Editor & OS junk
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db


# Local environment / secrets
.env
.env.*
!.env.example

# Temporary files
*.tmp
*.bak